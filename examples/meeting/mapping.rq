PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX doco:   <http://purl.org/spar/doco/>
PREFIX po:     <http://www.essepuntato.it/2008/12/pattern#>
PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX tok:    <urn:token:>
PREFIX ex:     <https://example.org/meeting#>

# Minutes are structured by their headings, so a section is the unit: who was
# there, what was decided, what is still open. The section a statement sits in
# is what tells them apart, and no annotation in the prose was needed for it.
CONSTRUCT {
  ?doc schema:attendee ?attendee ;
       ex:apologies ?apologies ;
       ex:scribe ?scribe .
  ?decision a ex:Decision ; schema:text ?decisionText ; ex:takenIn ?inSection .
  ?item a ex:OpenQuestion ; schema:text ?openText ; schema:agent ?owner ;
        schema:scheduledTime ?due ; schema:description ?note .
}
WHERE {
  ?doc a schema:DigitalDocument .
  OPTIONAL { ?doc (po:contains+)/tok:attendee ?attendee }
  OPTIONAL { ?doc (po:contains+)/tok:apologies ?apologies }
  OPTIONAL { ?doc (po:contains+)/tok:scribe ?scribe }
  OPTIONAL {
    ?inSection a doco:Section ; tok:decision ?decisionText .
    BIND(IRI(CONCAT(STR(?inSection), ".decision.", ENCODE_FOR_URI(?decisionText))) AS ?decision)
  }
  OPTIONAL {
    ?openSection a doco:Section ; tok:open ?openText .
    BIND(IRI(CONCAT(STR(?openSection), ".open")) AS ?item)
    OPTIONAL { ?openSection tok:owner ?owner }
    OPTIONAL { ?openSection tok:due ?due }
    OPTIONAL {
      ?openSection po:contains ?quote .
      ?quote a doco:BlockQuotation ; oa:hasSelector [ oa:exact ?quoted ] .
      # oa:exact is the source slice, so the quote markers are inside it and
      # taking them off is the mapping's job rather than the parser's.
      BIND(REPLACE(REPLACE(?quoted, "^> ", "", "m"), "\n", " ") AS ?note)
    }
  }
}
