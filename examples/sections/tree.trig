@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix schema: <https://schema.org/>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix oa: <http://www.w3.org/ns/oa#>.
@prefix doco: <http://purl.org/spar/doco/>.
@prefix po: <http://www.essepuntato.it/2008/12/pattern#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix token: <urn:token:>.
@prefix marginalia: <https://aleph.garden/ns/marginalia#>.

<urn:doc:sections> a schema:DigitalDocument.
<urn:doc:sections#sections> a doco:Section, oa:ResourceSelection;
    oa:hasSource <urn:doc:sections>;
    rdfs:label "Sections";
    marginalia:depth 1;
    marginalia:anchor "sections";
    oa:hasSelector <urn:doc:sections#sections.sel0>.
<urn:doc:sections#sections.sel0> a oa:FragmentSelector;
    rdf:value "Sections".
<urn:doc:sections> po:contains <urn:doc:sections#sections>.
<urn:doc:sections#sections> po:isContainedBy <urn:doc:sections>;
    po:contains <urn:doc:sections#sections.p1>.
<urn:doc:sections#sections.p1> po:isContainedBy <urn:doc:sections#sections>;
    a oa:ResourceSelection, doco:Paragraph;
    oa:hasSource <urn:doc:sections>;
    oa:hasSelector <urn:doc:sections#sections.p1.sel0>.
<urn:doc:sections#sections.p1.sel0> a oa:TextQuoteSelector;
    oa:exact "CommonMark has no sections. Its tree has headings as siblings of the blocks that\nfollow them, so the nesting every reader takes for granted is derived, not\nparsed. This example shows the derivation and what a mapping can do with it.".
<urn:doc:sections#sections> token:owner <urn:doc:toph>.
<urn:doc:sections#rules> a doco:Section, oa:ResourceSelection;
    oa:hasSource <urn:doc:sections>;
    rdfs:label "Rules";
    marginalia:depth 2;
    marginalia:anchor "rules";
    oa:hasSelector <urn:doc:sections#rules.sel0>.
<urn:doc:sections#rules.sel0> a oa:FragmentSelector;
    rdf:value "Rules".
<urn:doc:sections#sections> po:contains <urn:doc:sections#rules>.
<urn:doc:sections#rules> po:isContainedBy <urn:doc:sections#sections>;
    po:contains <urn:doc:sections#rules.p1>.
<urn:doc:sections#rules.p1> po:isContainedBy <urn:doc:sections#rules>;
    a oa:ResourceSelection, doco:Paragraph;
    oa:hasSource <urn:doc:sections>;
    oa:hasSelector <urn:doc:sections#rules.p1.sel0>.
<urn:doc:sections#rules.p1.sel0> a oa:TextQuoteSelector;
    oa:exact "A heading of depth *n* opens a section contained by the nearest open section of\nlesser depth. The same rule is written down in HTML as the document outline, and\nimplemented by `pandoc --section-divs` and `remark-sectionize`.".
<urn:doc:sections#rules> token:rule "nearest-lesser-depth".
<urn:doc:sections#skipping-a-level> a doco:Section, oa:ResourceSelection;
    oa:hasSource <urn:doc:sections>;
    rdfs:label "Skipping a level";
    marginalia:depth 4;
    marginalia:anchor "skipping-a-level";
    oa:hasSelector <urn:doc:sections#skipping-a-level.sel0>.
<urn:doc:sections#skipping-a-level.sel0> a oa:FragmentSelector;
    rdf:value "Skipping a level".
<urn:doc:sections#rules> po:contains <urn:doc:sections#skipping-a-level>.
<urn:doc:sections#skipping-a-level> po:isContainedBy <urn:doc:sections#rules>;
    po:contains <urn:doc:sections#skipping-a-level.p1>.
<urn:doc:sections#skipping-a-level.p1> po:isContainedBy <urn:doc:sections#skipping-a-level>;
    a oa:ResourceSelection, doco:Paragraph;
    oa:hasSource <urn:doc:sections>;
    oa:hasSelector <urn:doc:sections#skipping-a-level.p1.sel0>.
<urn:doc:sections#skipping-a-level.p1.sel0> a oa:TextQuoteSelector;
    oa:exact "The heading above this paragraph is depth 4 under depth 2. HTML calls such a jump non-conforming while still defining\nthe result. This format follows: the section below is reported as a diagnostic\nand nests under the nearest lesser depth anyway.".
<urn:doc:sections#skipping-a-level> token:note "a producer reports it, a consumer keeps working".
<urn:doc:sections#depth-is-not-the-tree> a doco:Section, oa:ResourceSelection;
    oa:hasSource <urn:doc:sections>;
    rdfs:label "Depth is not the tree";
    marginalia:depth 2;
    marginalia:anchor "depth-is-not-the-tree";
    oa:hasSelector <urn:doc:sections#depth-is-not-the-tree.sel0>.
<urn:doc:sections#depth-is-not-the-tree.sel0> a oa:FragmentSelector;
    rdf:value "Depth is not the tree".
<urn:doc:sections#sections> po:contains <urn:doc:sections#depth-is-not-the-tree>.
<urn:doc:sections#depth-is-not-the-tree> po:isContainedBy <urn:doc:sections#sections>;
    po:contains <urn:doc:sections#depth-is-not-the-tree.p1>.
<urn:doc:sections#depth-is-not-the-tree.p1> po:isContainedBy <urn:doc:sections#depth-is-not-the-tree>;
    a oa:ResourceSelection, doco:Paragraph;
    oa:hasSource <urn:doc:sections>;
    oa:hasSelector <urn:doc:sections#depth-is-not-the-tree.p1.sel0>.
<urn:doc:sections#depth-is-not-the-tree.p1.sel0> a oa:TextQuoteSelector;
    oa:exact "Because a document may skip a level, `depth = 1` is not the same question as\n\"has no section above it\". A mapping that wants top-level sections should ask\nthe containment, which `mapping.rq` does.".
<urn:doc:sections#depth-is-not-the-tree> token:caveat "ask containment, not depth".
