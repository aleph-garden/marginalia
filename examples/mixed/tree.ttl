<urn:doc:mixed#decisions.l1.i2> schema:position 2;
    rdfs:label "key a rule on the type, never on a heading".
<urn:doc:mixed#action-items> a doco:Section, oa:ResourceSelection;
    oa:hasSource <urn:doc:mixed>;
    rdfs:label "Action items";
    marginalia:depth 2;
    marginalia:anchor "action-items";
    oa:hasSelector <urn:doc:mixed#action-items.sel0>.
<urn:doc:mixed#action-items.sel0> a oa:FragmentSelector;
    rdf:value "Action items".
<urn:doc:mixed#planning-weekly> po:contains <urn:doc:mixed#action-items>.
<urn:doc:mixed#action-items> po:isContainedBy <urn:doc:mixed#planning-weekly>;
    a <http://www.w3.org/2005/01/wf/flow#Tracker>;
    po:contains <urn:doc:mixed#action-items.l1>.
<urn:doc:mixed#action-items.l1> po:isContainedBy <urn:doc:mixed#action-items>;
    a oa:ResourceSelection, doco:List;
    oa:hasSource <urn:doc:mixed>;
    oa:hasSelector <urn:doc:mixed#action-items.l1.sel0>.
<urn:doc:mixed#action-items.l1.sel0> a oa:TextQuoteSelector;
    oa:exact "- Write the task reading\n  - [x] Read the Flow ontology\n  - [ ] Check what nesting means\n- Send the minutes round".
<urn:doc:mixed#action-items.l1> po:contains <urn:doc:mixed#action-items.l1.i1>.
<urn:doc:mixed#action-items.l1.i1> po:isContainedBy <urn:doc:mixed#action-items.l1>;
    a oa:ResourceSelection, schema:ListItem;
    oa:hasSource <urn:doc:mixed>;
    oa:hasSelector <urn:doc:mixed#action-items.l1.i1.sel0>.
<urn:doc:mixed#action-items.l1.i1.sel0> a oa:TextQuoteSelector;
    oa:exact "- Write the task reading\n  - [x] Read the Flow ontology\n  - [ ] Check what nesting means".
<urn:doc:mixed#action-items.l1.i1> schema:position 1;
    rdfs:label "Write the task reading";
    po:contains <urn:doc:mixed#action-items.l1.i1.l1>.
<urn:doc:mixed#action-items.l1.i1.l1> po:isContainedBy <urn:doc:mixed#action-items.l1.i1>;
    a oa:ResourceSelection, doco:List;
    oa:hasSource <urn:doc:mixed>;
    oa:hasSelector <urn:doc:mixed#action-items.l1.i1.l1.sel0>.
<urn:doc:mixed#action-items.l1.i1.l1.sel0> a oa:TextQuoteSelector;
    oa:exact "- [x] Read the Flow ontology\n  - [ ] Check what nesting means".
<urn:doc:mixed#action-items.l1.i1.l1> po:contains <urn:doc:mixed#action-items.l1.i1.l1.i1>.
<urn:doc:mixed#action-items.l1.i1.l1.i1> po:isContainedBy <urn:doc:mixed#action-items.l1.i1.l1>;
    a oa:ResourceSelection, schema:ListItem;
    oa:hasSource <urn:doc:mixed>;
    oa:hasSelector <urn:doc:mixed#action-items.l1.i1.l1.i1.sel0>.
<urn:doc:mixed#action-items.l1.i1.l1.i1.sel0> a oa:TextQuoteSelector;
    oa:exact "- [x] Read the Flow ontology".
<urn:doc:mixed#action-items.l1.i1.l1.i1> schema:position 1;
    marginalia:checked true;
    rdfs:label "Read the Flow ontology".
<urn:doc:mixed#action-items.l1.i1.l1> po:contains <urn:doc:mixed#action-items.l1.i1.l1.i2>.
<urn:doc:mixed#action-items.l1.i1.l1.i2> po:isContainedBy <urn:doc:mixed#action-items.l1.i1.l1>;
    a oa:ResourceSelection, schema:ListItem;
    oa:hasSource <urn:doc:mixed>;
    oa:hasSelector <urn:doc:mixed#action-items.l1.i1.l1.i2.sel0>.
<urn:doc:mixed#action-items.l1.i1.l1.i2.sel0> a oa:TextQuoteSelector;
    oa:exact "- [ ] Check what nesting means".
<urn:doc:mixed#action-items.l1.i1.l1.i2> schema:position 2;
    marginalia:checked false;
    rdfs:label "Check what nesting means".
<urn:doc:mixed#action-items.l1> po:contains <urn:doc:mixed#action-items.l1.i2>.
<urn:doc:mixed#action-items.l1.i2> po:isContainedBy <urn:doc:mixed#action-items.l1>;
    a oa:ResourceSelection, schema:ListItem;
    oa:hasSource <urn:doc:mixed>;
    oa:hasSelector <urn:doc:mixed#action-items.l1.i2.sel0>.
<urn:doc:mixed#action-items.l1.i2.sel0> a oa:TextQuoteSelector;
    oa:exact "- Send the minutes round".
<urn:doc:mixed#action-items.l1.i2> schema:position 2;
    rdfs:label "Send the minutes round".
<urn:doc:mixed#action-items> po:contains <urn:doc:mixed#action-items.p2>.
<urn:doc:mixed#action-items.p2> po:isContainedBy <urn:doc:mixed#action-items>;
    a oa:ResourceSelection, doco:Paragraph;
    oa:hasSource <urn:doc:mixed>;
    oa:hasSelector <urn:doc:mixed#action-items.p2.sel0>.
<urn:doc:mixed#action-items.p2.sel0> a oa:TextQuoteSelector;
    oa:exact "The type on a section keeps the two apart. The task list is `po:contains`\naway from the section that carries `wf:Tracker`, and the minutes stop at a\nsection that declares a type of its own, so no decision comes out of the action\nitems and no task comes out of the decisions.".
<urn:doc:mixed#open> a doco:Section, oa:ResourceSelection;
    oa:hasSource <urn:doc:mixed>;
    rdfs:label "Open";
    marginalia:depth 2;
    marginalia:anchor "open";
    oa:hasSelector <urn:doc:mixed#open.sel0>.
<urn:doc:mixed#open.sel0> a oa:FragmentSelector;
    rdf:value "Open".
<urn:doc:mixed#planning-weekly> po:contains <urn:doc:mixed#open>.
<urn:doc:mixed#open> po:isContainedBy <urn:doc:mixed#planning-weekly>;
    token:open "whether a rule may follow an `@subject` redirect";
    token:owner <urn:doc:people/cristian>;
    token:due "2026-10-09";
    po:contains <urn:doc:mixed#open.q1>.
<urn:doc:mixed#open.q1> po:isContainedBy <urn:doc:mixed#open>;
    a oa:ResourceSelection, doco:BlockQuotation;
    oa:hasSource <urn:doc:mixed>;
    oa:hasSelector <urn:doc:mixed#open.q1.sel0>.
<urn:doc:mixed#open.q1.sel0> a oa:TextQuoteSelector;
    oa:exact "> A rule that follows the redirect reads the thing the section names. A rule\n> that stays put reads the section.".
