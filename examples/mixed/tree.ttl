@prefix marginalia: <https://aleph.garden/ns/marginalia#>.

<urn:doc:mixed> a schema:DigitalDocument, schema:Event;
    schema:startDate "2026-09-25T10:00:00Z".
<urn:doc:mixed#planning-weekly> a doco:Section, oa:ResourceSelection;
    oa:hasSource <urn:doc:mixed>;
    rdfs:label "Planning, weekly";
    marginalia:depth 1;
    marginalia:anchor "planning-weekly";
    oa:hasSelector <urn:doc:mixed#planning-weekly.sel0>.
<urn:doc:mixed#planning-weekly.sel0> a oa:FragmentSelector;
    rdf:value "Planning, weekly".
<urn:doc:mixed> po:contains <urn:doc:mixed#planning-weekly>.
<urn:doc:mixed#planning-weekly> po:isContainedBy <urn:doc:mixed>;
    po:contains <urn:doc:mixed#planning-weekly.p1>.
<urn:doc:mixed#planning-weekly.p1> po:isContainedBy <urn:doc:mixed#planning-weekly>;
    a oa:ResourceSelection, doco:Paragraph;
    oa:hasSource <urn:doc:mixed>;
    oa:hasSelector <urn:doc:mixed#planning-weekly.p1.sel0>.
<urn:doc:mixed#planning-weekly.p1.sel0> a oa:TextQuoteSelector;
    oa:exact "Two shipped readings of one note. The frontmatter types the document\n`schema:Event`, so `mappings/meeting.rq` reads minutes out of it. The action\nitems below type their own section `wf:Tracker`, so `mappings/todo.rq` reads a\ntask list out of that section and nothing else. Both rules see the same\nstructural graph, and `map examples/mixed/README.md mappings/*.rq` runs them together.".
<urn:doc:mixed#attending> a doco:Section, oa:ResourceSelection;
    oa:hasSource <urn:doc:mixed>;
    rdfs:label "Attending";
    marginalia:depth 2;
    marginalia:anchor "attending";
    oa:hasSelector <urn:doc:mixed#attending.sel0>.
<urn:doc:mixed#attending.sel0> a oa:FragmentSelector;
    rdf:value "Attending".
<urn:doc:mixed#planning-weekly> po:contains <urn:doc:mixed#attending>.
<urn:doc:mixed#attending> po:isContainedBy <urn:doc:mixed#planning-weekly>;
    token:attendee <urn:doc:people/toph>, <urn:doc:people/cristian>;
    po:contains <urn:doc:mixed#attending.p1>.
<urn:doc:mixed#attending.p1> po:isContainedBy <urn:doc:mixed#attending>;
    a oa:ResourceSelection, doco:Paragraph;
    oa:hasSource <urn:doc:mixed>;
    oa:hasSelector <urn:doc:mixed#attending.p1.sel0>.
<urn:doc:mixed#attending.p1.sel0> a oa:TextQuoteSelector;
    oa:exact "Notes were taken by [Toph](<> \"scribe\").".
<urn:doc:mixed#attending> token:scribe "Toph".
<urn:doc:mixed#decisions> a doco:Section, oa:ResourceSelection;
    oa:hasSource <urn:doc:mixed>;
    rdfs:label "Decisions";
    marginalia:depth 2;
    marginalia:anchor "decisions";
    oa:hasSelector <urn:doc:mixed#decisions.sel0>.
<urn:doc:mixed#decisions.sel0> a oa:FragmentSelector;
    rdf:value "Decisions".
<urn:doc:mixed#planning-weekly> po:contains <urn:doc:mixed#decisions>.
<urn:doc:mixed#decisions> po:isContainedBy <urn:doc:mixed#planning-weekly>;
    po:contains <urn:doc:mixed#decisions.l1>.
<urn:doc:mixed#decisions.l1> po:isContainedBy <urn:doc:mixed#decisions>;
    a oa:ResourceSelection, doco:List;
    oa:hasSource <urn:doc:mixed>;
    oa:hasSelector <urn:doc:mixed#decisions.l1.sel0>.
<urn:doc:mixed#decisions.l1.sel0> a oa:TextQuoteSelector;
    oa:exact "- ship one rule per kind of document\n- key a rule on the type, never on a heading".
<urn:doc:mixed#decisions.l1> po:contains <urn:doc:mixed#decisions.l1.i1>.
<urn:doc:mixed#decisions.l1.i1> po:isContainedBy <urn:doc:mixed#decisions.l1>;
    a oa:ResourceSelection, schema:ListItem;
    oa:hasSource <urn:doc:mixed>;
    oa:hasSelector <urn:doc:mixed#decisions.l1.i1.sel0>.
<urn:doc:mixed#decisions.l1.i1.sel0> a oa:TextQuoteSelector;
    oa:exact "- ship one rule per kind of document".
<urn:doc:mixed#decisions.l1.i1> schema:position 1;
    rdfs:label "ship one rule per kind of document".
<urn:doc:mixed#decisions.l1> po:contains <urn:doc:mixed#decisions.l1.i2>.
