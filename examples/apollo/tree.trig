    po:contains <urn:doc:apollo#Apollo%2011.p1>.
<urn:doc:apollo#Apollo%2011.p1> po:isContainedBy <urn:doc:apollo#Apollo%2011>;
    a oa:ResourceSelection, doco:Paragraph;
