    oa:hasSelector <urn:doc:apollo#Apollo%2011.p1.sel0>.
<urn:doc:apollo#Apollo%2011.p1.sel0> a oa:TextQuoteSelector;
    oa:exact "The first crewed landing on the Moon. This file is both the example and its own\nexplanation: everything below is ordinary CommonMark, and the graph beside it in\n`tree.ttl` is what the format reads out of it.".
<urn:doc:apollo#Apollo%2011> token:broader <urn:doc:space-missions>;
    token:focus <https://www.wikidata.org/entity/Q43653>;
    po:contains <urn:doc:apollo#Apollo%2011.p2>.
<urn:doc:apollo#Apollo%2011.p2> po:isContainedBy <urn:doc:apollo#Apollo%2011>;
    a oa:ResourceSelection, doco:Paragraph;
    oa:hasSource <urn:doc:apollo>;
    oa:hasSelector <urn:doc:apollo#Apollo%2011.p2.sel0>.
<urn:doc:apollo#Apollo%2011.p2.sel0> a oa:TextQuoteSelector;
    oa:exact "Three carriers are at work here. A **statement line** like the two above states\na fact about the section it sits in. A **gloss** marks a span of running prose:\ncommanded by [Neil Armstrong], launched in [1969], run by [NASA]. And the\n**structure** carries the rest, so this paragraph, the quotation and the code\nblock below all arrive as addressable slices without anyone annotating them.".
<urn:doc:apollo#Apollo%2011> token:commander "Neil Armstrong";
    token:year "1969";
    token:organizer <https://nasa.gov>.
<urn:doc:apollo#Landing> a doco:Section, oa:ResourceSelection;
    oa:hasSource <urn:doc:apollo>;
    rdfs:label "Landing";
    marginalia:depth 2;
    marginalia:anchor "landing";
    oa:hasSelector <urn:doc:apollo#Landing.sel0>.
<urn:doc:apollo#Landing.sel0> a oa:FragmentSelector;
