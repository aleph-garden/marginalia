<urn:doc:apollo#Apollo%2011> po:contains <urn:doc:apollo#Landing>.
<urn:doc:apollo#Landing> po:isContainedBy <urn:doc:apollo#Apollo%2011>;
    po:contains <urn:doc:apollo#Landing.p1>.
<urn:doc:apollo#Landing.p1> po:isContainedBy <urn:doc:apollo#Landing>;
    a oa:ResourceSelection, doco:Paragraph;
    oa:hasSource <urn:doc:apollo>;
    oa:hasSelector <urn:doc:apollo#Landing.p1.sel0>.
<urn:doc:apollo#Landing.p1.sel0> a oa:TextQuoteSelector;
    oa:exact "A gloss can also be written inline, which is the same rule with the annotation\nin the sentence instead of at the foot of the file: the module\n[Eagle](<> \"moduleName\") touched down at the\n[Sea of Tranquility](tranquility.md \"site\").".
<urn:doc:apollo#Landing> token:moduleName "Eagle";
    token:site <urn:doc:tranquility>;
    po:contains <urn:doc:apollo#Landing.q2>.
<urn:doc:apollo#Landing.q2> po:isContainedBy <urn:doc:apollo#Landing>;
    a oa:ResourceSelection, doco:BlockQuotation;
    oa:hasSource <urn:doc:apollo>;
    oa:hasSelector <urn:doc:apollo#Landing.q2.sel0>.
<urn:doc:apollo#Landing.q2.sel0> a oa:TextQuoteSelector;
    oa:exact "> That's one small step for a man, one giant leap for mankind.".
<urn:doc:apollo#Landing> po:contains <urn:doc:apollo#Landing.c3>.
