    oa:hasSelector <urn:doc:lists#steps.p2.sel0>.
<urn:doc:lists#steps.p2.sel0> a oa:TextQuoteSelector;
    oa:exact "An item holds the blocks below its first paragraph the way a section holds the\nblocks below its heading, so the nested list above is contained by the item it\nsits under rather than by this section.".
<urn:doc:lists#packing> a doco:Section, oa:ResourceSelection;
    oa:hasSource <urn:doc:lists>;
    rdfs:label "Packing";
    marginalia:depth 2;
