    oa:hasSource <urn:doc:lists>;
    oa:hasSelector <urn:doc:lists#packing.l1.i2.sel0>.
<urn:doc:lists#packing.l1.i2.sel0> a oa:TextQuoteSelector;
    oa:exact "- [ ] Tickets".
<urn:doc:lists#packing.l1.i2> schema:position 2;
    marginalia:checked false;
    rdfs:label "Tickets".
<urn:doc:lists#packing.l1> po:contains <urn:doc:lists#packing.l1.i3>.
<urn:doc:lists#packing.l1.i3> po:isContainedBy <urn:doc:lists#packing.l1>;
    a oa:ResourceSelection, schema:ListItem;
    oa:hasSource <urn:doc:lists>;
    oa:hasSelector <urn:doc:lists#packing.l1.i3.sel0>.
<urn:doc:lists#packing.l1.i3.sel0> a oa:TextQuoteSelector;
    oa:exact "- [ ] An [adapter](<> \"spare\") for the other plug".
<urn:doc:lists#packing.l1.i3> schema:position 3;
    marginalia:checked false;
    rdfs:label "An adapter for the other plug";
    token:spare "adapter".
<urn:doc:lists#packing> po:contains <urn:doc:lists#packing.p2>.
<urn:doc:lists#packing.p2> po:isContainedBy <urn:doc:lists#packing>;
    a oa:ResourceSelection, doco:Paragraph;
    oa:hasSource <urn:doc:lists>;
    oa:hasSelector <urn:doc:lists#packing.p2.sel0>.
<urn:doc:lists#packing.p2.sel0> a oa:TextQuoteSelector;
    oa:exact "A checkbox is GFM, so the state of the box is structure and\n`marginalia:checked` carries it. What a tick means is left to a mapping. The\ngloss in the third entry states its fact about the item, because inside an item\nthe item is the subject.".
