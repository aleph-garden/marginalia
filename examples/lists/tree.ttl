    oa:hasSource <urn:doc:lists>;
    oa:hasSelector <urn:doc:lists#packing.l1.i1.sel0>.
<urn:doc:lists#packing.l1.i1.sel0> a oa:TextQuoteSelector;
    oa:exact "- [x] Passport".
<urn:doc:lists#packing.l1.i1> schema:position 1;
    marginalia:checked true;
    rdfs:label "Passport".
<urn:doc:lists#packing.l1> po:contains <urn:doc:lists#packing.l1.i2>.
<urn:doc:lists#packing.l1.i2> po:isContainedBy <urn:doc:lists#packing.l1>;
