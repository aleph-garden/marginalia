    a oa:ResourceSelection, doco:List;
    oa:hasSource <urn:doc:lists>;
    oa:hasSelector <urn:doc:lists#packing.l1.sel0>.
<urn:doc:lists#packing.l1.sel0> a oa:TextQuoteSelector;
    oa:exact "- [x] Passport\n- [ ] Tickets\n- [ ] An [adapter](<> \"spare\") for the other plug".
<urn:doc:lists#packing.l1> po:contains <urn:doc:lists#packing.l1.i1>.
<urn:doc:lists#packing.l1.i1> po:isContainedBy <urn:doc:lists#packing.l1>;
