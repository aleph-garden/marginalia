    oa:hasSelector <urn:doc:lists#work.p2.sel0>.
<urn:doc:lists#work.p2.sel0> a oa:TextQuoteSelector;
    oa:exact "A statement line in an item's continuation is about the item, so a list of work\nitems reads without a heading for each one.".
