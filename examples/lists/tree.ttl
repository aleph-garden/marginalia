<urn:doc:lists> a schema:DigitalDocument.
<urn:doc:lists#lists> a doco:Section, oa:ResourceSelection;
    oa:hasSource <urn:doc:lists>;
    rdfs:label "Lists";
    marginalia:depth 1;
    marginalia:anchor "lists";
    oa:hasSelector <urn:doc:lists#lists.sel0>.
<urn:doc:lists#lists.sel0> a oa:FragmentSelector;
    rdf:value "Lists".
<urn:doc:lists> po:contains <urn:doc:lists#lists>.
<urn:doc:lists#lists> po:isContainedBy <urn:doc:lists>;
    po:contains <urn:doc:lists#lists.p1>.
<urn:doc:lists#lists.p1> po:isContainedBy <urn:doc:lists#lists>;
    a oa:ResourceSelection, doco:Paragraph;
    oa:hasSource <urn:doc:lists>;
    oa:hasSelector <urn:doc:lists#lists.p1.sel0>.
<urn:doc:lists#lists.p1.sel0> a oa:TextQuoteSelector;
    oa:exact "A list whose lines are not all statement lines becomes a `doco:List`, and every\nentry becomes an item: an addressable slice carrying its position, the text of\nits first paragraph as its label, and whatever that entry states about itself.".
