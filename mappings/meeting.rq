PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema:  <https://schema.org/>
PREFIX doco:    <http://purl.org/spar/doco/>
PREFIX po:      <http://www.essepuntato.it/2008/12/pattern#>
PREFIX tok:     <urn:token:>
PREFIX minutes: <https://aleph.garden/ns/minutes#>

# Minutes. Whatever carries schema:Event is the meeting, and the sections under
# it say who was there and what was decided. The decisions are the entries of a
# list under whatever carries minutes:Decisions, so an agenda or any other list
# in the same document stays with the rule that reads it: a section of open
# items typed wf:Tracker goes to todo.rq.
CONSTRUCT {
  ?meeting schema:attendee ?attendee ;
           minutes:apologies ?apologies ;
           minutes:scribe ?scribe .
  ?decision a minutes:Decision ; schema:text ?decisionText .
}
WHERE {
  ?meeting a schema:Event .
  OPTIONAL { ?meeting (po:contains*)/tok:attendee ?attendee }
  OPTIONAL { ?meeting (po:contains*)/tok:apologies ?apologies }
  OPTIONAL { ?meeting (po:contains*)/tok:scribe ?scribe }
  # An item is already an identified slice, so the rule reads its label and
  # needs no identifier of its own. The section that holds it is in the
  # structural graph, which is where a consumer asking where a decision was
  # taken looks.
  OPTIONAL {
    ?meeting (po:contains*) ?decisions .
    ?decisions a minutes:Decisions ; po:contains ?list .
    ?list a doco:List ; po:contains ?decision .
    ?decision a schema:ListItem ; rdfs:label ?decisionText .
  }
}
