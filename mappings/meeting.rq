PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema:  <https://schema.org/>
PREFIX doco:    <http://purl.org/spar/doco/>
PREFIX po:      <http://www.essepuntato.it/2008/12/pattern#>
PREFIX oa:      <http://www.w3.org/ns/oa#>
PREFIX tok:     <urn:token:>
PREFIX minutes: <https://aleph.garden/ns/minutes#>

# Minutes. Whatever carries schema:Event is the meeting, and the sections under
# it say who was there and what was decided. A section that declares a type of
# its own is read by the rule for that type, so a section of open items typed
# wf:Tracker goes to todo.rq and the minutes leave its list alone.
CONSTRUCT {
  ?meeting schema:attendee ?attendee ;
           minutes:apologies ?apologies ;
           minutes:scribe ?scribe .
  ?decision a minutes:Decision ; schema:text ?decisionText .
}
WHERE {
  ?meeting a schema:Event .
  OPTIONAL { ?meeting (po:contains*)/tok:attendee ?attendee }
  OPTIONAL { ?meeting (po:contains*)/tok:apologies ?apologies }
  OPTIONAL { ?meeting (po:contains*)/tok:scribe ?scribe }
  # Each decision is an entry of the list under a heading, and an item is
  # already an identified slice, so the rule reads its label and needs no
  # identifier of its own. The section that holds it is in the structural
  # graph, which is where a consumer asking where a decision was taken looks.
  OPTIONAL {
    ?meeting (po:contains*) ?inSection .
    ?inSection a doco:Section ; po:contains ?list .
    ?list a doco:List ; po:contains ?decision .
    ?decision a schema:ListItem ; rdfs:label ?decisionText .
    FILTER NOT EXISTS {
      ?inSection a ?declared .
      FILTER(?declared != doco:Section && ?declared != oa:ResourceSelection)
    }
  }
}
