PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX doco: <http://purl.org/spar/doco/>
PREFIX po:   <http://www.essepuntato.it/2008/12/pattern#>
PREFIX mg:   <https://aleph.garden/ns/marginalia#>
PREFIX tok:  <urn:token:>
PREFIX wf:   <http://www.w3.org/2005/01/wf/flow#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

# A task list. Whatever carries wf:Tracker holds the tasks, and every list item
# under it is one: the label is the goal, the box says whether the task is open
# or closed, and an entry's nested list is the work that entry waits on. What
# the entry states about itself says who owns it and when it is due.
CONSTRUCT {
  ?task a wf:Task, ?state ;
        wf:tracker ?tracker ;
        wf:goalDescription ?goal ;
        wf:dateDue ?due ;
        schema:agent ?owner ;
        wf:dependent ?dependent .
}
WHERE {
  ?tracker a wf:Tracker ; (po:contains+) ?task .
  ?task a schema:ListItem ; rdfs:label ?goal .
  # Flow has wf:Task as the disjoint union of wf:Open and wf:Closed, so the
  # state is the class, and the union is written out for a consumer that runs
  # no reasoner. An entry with no box is open, which is what an unticked line
  # says.
  OPTIONAL { ?task mg:checked ?checked }
  BIND(IF(COALESCE(?checked, false), wf:Closed, wf:Open) AS ?state)
  # A bare due or owner under an entry means what a tracker says it means:
  # wf:dateDue takes dates, and schema:agent takes whoever the work is on. A due
  # written as a calendar date is typed xsd:date so a consumer can order and
  # compare it; any other wording stays the text the author wrote.
  OPTIONAL {
    ?task tok:due ?stated .
    BIND(IF(REGEX(STR(?stated), "^\\d{4}-\\d{2}-\\d{2}$"),
            STRDT(STR(?stated), xsd:date), ?stated) AS ?due)
  }
  OPTIONAL { ?task tok:owner ?owner }
  OPTIONAL {
    ?task po:contains [ a doco:List ; po:contains ?dependent ] .
    ?dependent a schema:ListItem .
  }
}
